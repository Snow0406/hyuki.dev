---
import MetaPage from "@/components/MetaPage.astro"
import DiscordPresence from "@/components/home/DiscordPresence.astro"
import LatestOptimization from "@/components/home/LatestOptimization.astro"
import Snowflakes from "@/components/home/Snowflakes.astro"
import WakatimeCalendar from "@/components/home/WakatimeCalendar.astro"
import WakatimeGraph from "@/components/home/WakatimeGraph.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"
import { Image } from "astro:assets"

const latestPost = (await getPosts()).at(0)
---

<Layout wide>
  <MetaPage slot="head" />
  <home-container>
    <home-bento>
      <article class="bento-card intro-card" style="grid-area: a">
        <Snowflakes />
        <div class="intro-content">
          <h1>Hello, I&rsquo;m Hy !</h1>
          <div>
            <p>
              I&rsquo;m a developer and student at University from Korea, active
              online as hy and snow.
            </p>
            <p>
              I&rsquo;m interested in Unity game development and optimization
            </p>
            <p>I adore subculture games and strawberry lattes ✨</p>
          </div>
        </div>
      </article>

      <article
        class="bento-card discord-card"
        style="grid-area: b"
        aria-label="Discord status preview"
      >
        <Snowflakes />
        <DiscordPresence />
      </article>

      <article class="bento-card latest-card" style="grid-area: d">
        <Snowflakes />
        {latestPost ? (
          <>
            <div class="latest-image">
              {latestPost.data.image ? (
                  <Image
                    src={latestPost.data.image}
                    alt={latestPost.data.title}
                    width={640}
                    height={336}
                  />
                ) : (
                  <div class="latest-placeholder" aria-hidden="true">
                    <span>Latest post</span>
                  </div>
                )}
            </div>
            <a
              class="card-action"
              href={`/blog/${latestPost.id}`}
              title={`Read blog post: ${latestPost.data.title}`}
              aria-label={`Read blog post: ${latestPost.data.title}`}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
          </>
        ) : (
          <p class="empty-state">The latest post will appear here.</p>
        )}
      </article>

      <article
        class="bento-card calendar-card"
        style="grid-area: e"
        aria-label="WakaTime calendar preview"
      >
        <Snowflakes />
        <WakatimeCalendar />
      </article>

      <article
        class="bento-card language-card"
        style="grid-area: f"
        aria-label="WakaTime language preview"
      >
        <Snowflakes />
        <WakatimeGraph />
      </article>

      <article
        class="bento-card optimization-card"
        style="grid-area: g"
        aria-label="Latest game optimization"
      >
        <Snowflakes />
        <LatestOptimization />
      </article>
    </home-bento>
  </home-container>
</Layout>

<style>
  home-container {
    container-type: inline-size;
    display: block;
    inline-size: 100%;
    max-inline-size: 23.4375rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  home-bento {
    --bento-gap: 1rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "a" "b" "f" "g" "e";
    gap: var(--bento-gap);
    inline-size: 100%;
  }

  .bento-card {
    position: relative;
    min-inline-size: 0;
    overflow: hidden;
    border: 2px solid rgba(180, 220, 255, 0.5);
    border-radius: var(--radius-3xl);
    background-color: color-mix(in oklab, var(--secondary) 25%, transparent);
    box-shadow:
      0 0 15px 3px rgba(100, 180, 255, 0.25),
      0 0 25px 5px rgba(130, 200, 255, 0.15) inset;
  }

  :global(:root[data-theme="dark"]) .bento-card {
    border-color: rgba(180, 220, 255, 0.3);
    box-shadow:
      0 0 12px 2px rgba(120, 200, 255, 0.15),
      0 0 20px 4px rgba(150, 220, 255, 0.08) inset;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .bento-card {
      border-color: rgba(180, 220, 255, 0.3);
      box-shadow:
        0 0 12px 2px rgba(120, 200, 255, 0.15),
        0 0 20px 4px rgba(150, 220, 255, 0.08) inset;
    }
  }

  .intro-card {
    min-block-size: 17rem;
  }

  .intro-content {
    position: relative;
    z-index: 1;
    padding: var(--space-m);

    h1 {
      margin: 0 0 var(--space-m);
      font-size: var(--step-3);
      line-height: 1;
      font-weight: 600;
      letter-spacing: -0.025em;
    }

    p {
      margin: 0;
      color: var(--muted-foreground);
      font-size: var(--step--1);
      line-height: 1.5;
      text-wrap: pretty;
    }

    p + p {
      margin-block-start: var(--space-2xs);
    }
  }

  .discord-card,
  .language-card,
  .calendar-card,
  .optimization-card {
    aspect-ratio: 1;
  }

  .calendar-card {
    display: block;
  }

  .optimization-card {
    container-type: size;
  }

  .latest-card {
    display: none;
  }

  .latest-image {
    position: relative;
    flex: none;
    inline-size: 85%;
    aspect-ratio: 477 / 251;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);

    :global(img),
    .latest-placeholder {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }
  }

  .latest-placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--muted), var(--secondary));
    color: var(--muted-foreground);
  }

  .card-action {
    position: absolute;
    z-index: 2;
    inset: auto var(--space-xs) var(--space-xs) auto;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    aspect-ratio: 1;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--secondary) 55%, transparent);
    color: var(--primary);
    transition: box-shadow 0.3s ease;

    &:hover,
    &:focus-visible {
      box-shadow: 0 0 0 2px var(--ring);
    }

    svg {
      inline-size: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2;
      transition: transform 0.3s ease;
    }

    &:hover svg {
      transform: rotate(12deg);
    }
  }

  .empty-state {
    position: relative;
    z-index: 1;
    padding: var(--space-m);
    color: var(--muted-foreground);
  }

  .language-card {
    container-type: size;
  }

  @media (width >= 40rem) {
    home-container {
      max-inline-size: 40rem;
    }

    home-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: "a a" "b f" "e e";
    }

    .intro-card {
      min-block-size: auto;
      aspect-ratio: 2.7 / 1;
    }

    .intro-content {
      position: absolute;
      inset: 0;
    }

    .calendar-card {
      display: block;
      aspect-ratio: 2.1 / 1;
    }

    .optimization-card {
      display: none;
    }
  }

  @media (width >= 80rem) {
    home-container {
      max-inline-size: 48rem;
    }

    home-bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas: "a a b" "f d d" "e e g";
    }

    .intro-card {
      aspect-ratio: auto;
    }

    .latest-card {
      display: flex;
      align-items: flex-start;
      padding: 1rem;
    }

    .calendar-card {
      aspect-ratio: auto;
    }

    .optimization-card {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-action,
    .card-action svg {
      transition: none;
    }
  }
</style>
