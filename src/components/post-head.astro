---
import { SITE } from '@/consts'
import { isSubpost } from '@/lib/data-utils'
import type { CollectionEntry, CollectionKey } from 'astro:content'

interface Props<T extends CollectionKey> {
  post: CollectionEntry<T>
}

const { post } = Astro.props

type SeoData = {
  title?: string
  name?: string
  description?: string
  image?: { src: string }
  authors?: string[]
  tags?: string[]
  date?: Date
}

const data = post.data as SeoData
const base = Astro.site ?? new URL(Astro.url.origin)
const url = new URL(Astro.url.pathname, base)
const title = data.title ?? data.name ?? SITE.title
const description = data.description ?? SITE.description
const image = data.image?.src
  ? new URL(data.image.src, base)
  : new URL('/static/twitter-card.png', base)
const isArticle = post.collection === 'blog'
const author =
  data.authors && data.authors.length > 0
    ? data.authors.join(', ')
    : SITE.author
---

<title>{`${title} | ${SITE.title}`}</title>
<meta name="title" content={`${title} | ${SITE.title}`} />
<meta name="description" content={description} />
<link rel="canonical" href={url} />

{isSubpost(post.id) && <meta name="robots" content="noindex" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={title} />
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={url} />

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={author} />

{
  isArticle && data.date && (
    <meta property="article:published_time" content={data.date.toISOString()} />
  )
}
{
  isArticle &&
    data.authors?.map((name) => (
      <meta property="article:author" content={name} />
    ))
}
{
  isArticle &&
    data.tags?.map((tag) => {
      return <meta property="article:tag" content={tag} />
    })
}
