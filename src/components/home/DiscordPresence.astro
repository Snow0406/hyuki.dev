---
const DISCORD_USER_ID = "453729488191094809"
---

<discord-presence data-user-id={DISCORD_USER_ID} data-loading aria-busy="true">
  <div class="discord-banner" aria-hidden="true"></div>
  <div class="discord-content">
    <div class="discord-heading">
      <div class="discord-avatar">
        <span class="discord-avatar-fallback" aria-hidden="true"></span>
        <img
          class="discord-avatar-image"
          alt="Discord avatar"
          width="96"
          height="96"
        >
        <img
          class="discord-avatar-decoration"
          alt=""
          width="112"
          height="112"
          aria-hidden="true"
        >
        <i
          data-status="offline"
          role="img"
          aria-label="Discord status unavailable"
        ></i>
      </div>
      <div class="discord-badges">
        <img
          src="/static/discord_badge.svg"
          alt="Discord profile badges"
          width="104"
          height="24"
        >
      </div>
    </div>
    <div class="discord-profile">
      <strong></strong>
      <span></span>
    </div>
    <div class="discord-activity" aria-live="polite">
      <img class="discord-activity-art" alt="" width="48" height="48">
      <div class="discord-activity-copy">
        <span></span>
        <strong></strong>
        <small class="discord-activity-detail"></small>
        <small class="discord-activity-state"></small>
        <small class="discord-activity-time"></small>
        <div class="discord-spotify-progress" aria-label="Spotify progress">
          <small class="discord-spotify-current">0:00</small>
          <i aria-hidden="true"><b></b></i>
          <small class="discord-spotify-total">0:00</small>
        </div>
      </div>
    </div>
  </div>
</discord-presence>

<style>
  discord-presence {
    container-type: inline-size;
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
  }

  .discord-banner {
    position: absolute;
    inset: 0 0 auto;
    block-size: 27%;
    background:
      radial-gradient(
        circle at 72% 30%,
        var(--strawberry) 0 2px,
        transparent 3px
      ),
      linear-gradient(135deg, var(--secondary), var(--muted));
    opacity: 0.8;
  }

  .discord-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 15% var(--space-xs) var(--space-xs);
  }

  .discord-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .discord-avatar {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: clamp(3.75rem, 27cqw, 4.5rem);
    aspect-ratio: 1;
    border: 4px solid var(--background);
    border-radius: var(--radius-full);
    background: linear-gradient(145deg, var(--primary), var(--chart-4));
    color: var(--primary-foreground);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .discord-avatar-image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border-radius: inherit;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .discord-avatar-image[data-loaded] {
    opacity: 1;
  }

  .discord-avatar-decoration {
    position: absolute;
    z-index: 1;
    inset: 50% auto auto 50%;
    inline-size: 130%;
    max-inline-size: none;
    transform: translate(-50%, -50%);
  }

  .discord-avatar-decoration:not([src]) {
    display: none;
  }

  .discord-avatar i {
    --discord-status-inner-size: 0.5rem;

    position: absolute;
    z-index: 2;
    inset: auto 0 0 auto;
    display: grid;
    place-items: center;
    inline-size: 1.5rem;
    aspect-ratio: 1;
    border: 4px solid var(--background);
    border-radius: var(--radius-full);
    background-color: var(--muted-foreground);
  }

  .discord-avatar i::after {
    content: "";
    inline-size: var(--discord-status-inner-size);
    aspect-ratio: 1;
    border-radius: inherit;
    background-color: var(--background);
  }

  .discord-avatar i[data-status="online"] {
    background-color: #78d6a5;
  }

  .discord-avatar i[data-status="online"]::after {
    display: none;
  }

  .discord-avatar i[data-status="idle"] {
    align-items: start;
    justify-items: start;
    background-color: #f3d58a;
  }

  .discord-avatar i[data-status="idle"]::after {
    --discord-status-inner-size: 0.625rem;
  }

  .discord-avatar i[data-status="dnd"] {
    background-color: #f08f9a;
  }

  .discord-avatar i[data-status="dnd"]::after {
    inline-size: 0.6875rem;
    block-size: 0.25rem;
    aspect-ratio: auto;
  }

  .discord-badges {
    display: flex;
    align-items: center;
    margin-block-end: var(--space-2xs);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-xl);
    background-color: color-mix(in oklab, var(--secondary) 55%, transparent);
  }

  .discord-badges img {
    inline-size: clamp(5.625rem, 42cqw, 6.5rem);
    block-size: auto;
  }

  .discord-profile {
    display: flex;
    flex-direction: column;
    margin-block-start: var(--space-2xs);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-xl);
    background-color: color-mix(in oklab, var(--secondary) 45%, transparent);
  }

  .discord-profile strong {
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .discord-profile span {
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .discord-activity {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    flex: 1;
    min-block-size: 3.25rem;
    margin-block-start: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-xl);
    background-color: color-mix(in oklab, var(--secondary) 45%, transparent);
  }

  .discord-activity-art {
    display: none;
    inline-size: clamp(2.25rem, 18cqw, 3rem);
    aspect-ratio: 1;
    flex: none;
    border-radius: var(--radius-xl);
    object-fit: cover;
  }

  .discord-activity-art[data-visible] {
    display: block;
  }

  .discord-activity-copy {
    display: flex;
    flex: 1;
    min-inline-size: 0;
    flex-direction: column;
    justify-content: center;
  }

  .discord-activity span,
  .discord-activity small {
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: clamp(0.5625rem, 3.2cqw, 0.6875rem);
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .discord-activity strong {
    overflow: hidden;
    font-size: clamp(0.75rem, 4cqw, 0.875rem);
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .discord-activity-time:empty {
    display: none;
  }

  discord-presence[data-loading] .discord-avatar,
  discord-presence[data-loading] .discord-badges,
  discord-presence[data-loading] .discord-profile strong::after,
  discord-presence[data-loading] .discord-profile span::after,
  discord-presence[data-loading] .discord-activity-copy > span::after,
  discord-presence[data-loading] .discord-activity-copy > strong::after,
  discord-presence[data-loading] .discord-activity-detail::after {
    background: linear-gradient(
      100deg,
      color-mix(in oklab, var(--muted-foreground) 12%, transparent) 30%,
      color-mix(in oklab, var(--muted-foreground) 24%, transparent) 50%,
      color-mix(in oklab, var(--muted-foreground) 12%, transparent) 70%
    );
    background-size: 200% 100%;
    animation: discord-skeleton 1.5s ease-in-out infinite;
  }

  discord-presence[data-loading] .discord-avatar-image,
  discord-presence[data-loading] .discord-avatar-decoration,
  discord-presence[data-loading] .discord-badges img {
    opacity: 0;
  }

  discord-presence[data-loading] .discord-avatar i {
    background-color: color-mix(
      in oklab,
      var(--muted-foreground) 18%,
      var(--background)
    );
  }

  discord-presence[data-loading] .discord-avatar i::after {
    display: none;
  }

  discord-presence[data-loading] .discord-profile strong::after,
  discord-presence[data-loading] .discord-profile span::after,
  discord-presence[data-loading] .discord-activity-copy > span::after,
  discord-presence[data-loading] .discord-activity-copy > strong::after,
  discord-presence[data-loading] .discord-activity-detail::after {
    content: "";
    display: block;
    border-radius: var(--radius-full);
  }

  discord-presence[data-loading] .discord-profile strong::after {
    inline-size: 28%;
    block-size: 0.65rem;
  }

  discord-presence[data-loading] .discord-profile span::after {
    inline-size: 52%;
    block-size: 0.55rem;
    margin-block-start: 0.15rem;
  }

  discord-presence[data-loading] .discord-activity-copy > span::after {
    inline-size: 44%;
    block-size: 0.45rem;
  }

  discord-presence[data-loading] .discord-activity-copy > strong::after {
    inline-size: 68%;
    block-size: 0.65rem;
    margin-block-start: 0.25rem;
  }

  discord-presence[data-loading] .discord-activity-detail::after {
    inline-size: 52%;
    block-size: 0.45rem;
    margin-block-start: 0.25rem;
  }

  @keyframes discord-skeleton {
    from {
      background-position: 100% 0;
    }

    to {
      background-position: -100% 0;
    }
  }

  .discord-activity-state:empty {
    display: none;
  }

  .discord-spotify-progress {
    display: none;
    align-items: center;
    gap: 0.35rem;
    min-inline-size: 0;
    margin-block-start: 0.125rem;
  }

  .discord-activity[data-spotify] > .discord-activity-art {
    inline-size: clamp(2.75rem, 21cqw, 3.5rem);
  }

  .discord-activity[data-spotify] .discord-activity-copy > span,
  .discord-activity[data-spotify] .discord-activity-time {
    display: none;
  }

  .discord-activity[data-spotify] .discord-spotify-progress {
    display: flex;
  }

  .discord-spotify-progress small {
    flex: none;
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 2.6cqw, 0.5625rem);
  }

  .discord-spotify-progress i {
    block-size: 0.1875rem;
    min-inline-size: 1.5rem;
    flex: 1;
    overflow: hidden;
    border-radius: var(--radius-full);
    background-color: color-mix(
      in oklab,
      var(--muted-foreground) 20%,
      transparent
    );
  }

  .discord-spotify-progress b {
    display: block;
    inline-size: 0;
    block-size: 100%;
    border-radius: inherit;
    background-color: #b7a6f6;
    box-shadow: 0 0 0.4rem color-mix(in oklab, #b7a6f6 70%, transparent);
    transition: inline-size 1s linear;
  }

  .discord-activity[data-empty] {
    justify-content: center;
  }

  .discord-activity[data-empty] .discord-activity-copy {
    flex: 1;
    align-items: center;
  }

  .discord-activity[data-empty] span,
  .discord-activity[data-empty] small,
  .discord-activity[data-empty] .discord-spotify-progress {
    display: none;
  }

  .discord-activity[data-empty] strong {
    color: var(--muted-foreground);
    font-size: clamp(0.5rem, 3cqw, 0.625rem);
    font-weight: 400;
    line-height: 1;
  }

  @media (width >= 80rem) {
    .discord-content {
      padding: 12% var(--space-2xs) var(--space-2xs);
    }

    .discord-avatar {
      inline-size: 3.75rem;
    }

    .discord-avatar i {
      --discord-status-inner-size: 0.375rem;

      inline-size: 1.25rem;
      border-width: 3px;
    }

    .discord-avatar i[data-status="idle"]::after {
      --discord-status-inner-size: 0.5rem;
    }

    .discord-avatar i[data-status="dnd"]::after {
      inline-size: 0.5625rem;
      block-size: 0.1875rem;
    }

    .discord-profile,
    .discord-activity {
      margin-block-start: var(--space-3xs);
    }

    .discord-activity {
      min-block-size: 2.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discord-avatar-image,
    .discord-spotify-progress b {
      transition: none;
    }

    discord-presence[data-loading] .discord-avatar,
    discord-presence[data-loading] .discord-badges,
    discord-presence[data-loading] .discord-profile strong::after,
    discord-presence[data-loading] .discord-profile span::after,
    discord-presence[data-loading] .discord-activity-copy > span::after,
    discord-presence[data-loading] .discord-activity-copy > strong::after,
    discord-presence[data-loading] .discord-activity-detail::after {
      animation: none;
    }
  }
</style>

<script>
  type DiscordStatus = "online" | "idle" | "dnd" | "offline"

  interface DiscordActivity {
    type: number
    application_id?: string
    name?: string
    details?: string
    state?: string
    timestamps?: { start?: number; end?: number }
    assets?: { large_image?: string }
  }

  interface LanyardResponse {
    success: boolean
    data?: {
      discord_status: DiscordStatus
      discord_user: {
        id: string
        username: string
        global_name?: string | null
        display_name?: string | null
        avatar?: string | null
        avatar_decoration_data?: { asset?: string | null } | null
      }
      activities: DiscordActivity[]
    }
  }

  const STATUS_LABELS: Record<DiscordStatus, string> = {
    online: "Online",
    idle: "Idle",
    dnd: "Do Not Disturb",
    offline: "Offline",
  }

  const REFRESH_MS = 60_000
  const REQUEST_TIMEOUT_MS = 8_000

  const activityAssetUrl = (activity: DiscordActivity) => {
    const asset = activity.assets?.large_image
    if (!asset) return ""
    if (asset.startsWith("spotify:")) {
      return `https://i.scdn.co/image/${asset.slice("spotify:".length)}`
    }
    if (asset.startsWith("mp:")) {
      return `https://media.discordapp.net/${asset.slice("mp:".length)}`
    }
    if (!activity.application_id) return ""
    return `https://cdn.discordapp.com/app-assets/${activity.application_id}/${asset}.webp?size=96`
  }

  class DiscordPresenceElement extends HTMLElement {
    private controller: AbortController | null = null
    private refreshId: number | null = null
    private tickerId: number | null = null
    private activityStartedAt: number | null = null
    private activityEndsAt: number | null = null
    private loaded = false

    connectedCallback() {
      if (this.refreshId !== null) return

      void this.refresh()
      this.refreshId = window.setInterval(() => {
        if (document.visibilityState === "visible") void this.refresh()
      }, REFRESH_MS)
      this.tickerId = window.setInterval(() => this.updateActivityTime(), 1_000)
      document.addEventListener("visibilitychange", this.refreshWhenVisible)
    }

    disconnectedCallback() {
      this.controller?.abort()
      if (this.refreshId !== null) window.clearInterval(this.refreshId)
      if (this.tickerId !== null) window.clearInterval(this.tickerId)
      this.refreshId = null
      this.tickerId = null
      document.removeEventListener("visibilitychange", this.refreshWhenVisible)
    }

    private refreshWhenVisible = () => {
      if (document.visibilityState === "visible") void this.refresh()
    }

    private async refresh() {
      if (this.controller) return

      const userId = this.dataset.userId
      if (!userId) return

      const controller = new AbortController()
      this.controller = controller
      const timeoutId = window.setTimeout(
        () => controller.abort(),
        REQUEST_TIMEOUT_MS,
      )

      try {
        const response = await fetch(
          `https://api.lanyard.rest/v1/users/${userId}`,
          { signal: controller.signal },
        )
        if (!response.ok) throw new Error(`Lanyard returned ${response.status}`)

        const body = (await response.json()) as LanyardResponse
        if (!body.success || !body.data)
          throw new Error("Invalid Lanyard response")

        this.renderPresence(body.data)
        this.loaded = true
        this.removeAttribute("data-loading")
        this.setAttribute("aria-busy", "false")
      } catch {
        if (!this.loaded) this.renderUnavailable()
      } finally {
        window.clearTimeout(timeoutId)
        if (this.controller === controller) this.controller = null
      }
    }

    private renderPresence(data: NonNullable<LanyardResponse["data"]>) {
      const user = data.discord_user
      const displayName = user.global_name || user.display_name || user.username
      const profileName = this.querySelector<HTMLElement>(
        ".discord-profile strong",
      )
      const profileHandle = this.querySelector<HTMLElement>(
        ".discord-profile span",
      )
      const indicator = this.querySelector<HTMLElement>(".discord-avatar i")

      if (profileName) profileName.textContent = displayName
      if (profileHandle) profileHandle.textContent = `@${user.username}`
      if (indicator) {
        indicator.dataset.status = data.discord_status
        indicator.setAttribute(
          "aria-label",
          `Discord status: ${STATUS_LABELS[data.discord_status]}`,
        )
      }

      this.renderAvatar(user)

      const activity =
        data.activities.find((item) => item.type === 0 && item.assets) ||
        data.activities.find(
          (item) => item.type === 2 && item.name === "Spotify",
        )

      if (activity) this.renderActivity(activity)
      else this.renderNoActivity()
    }

    private renderAvatar(
      user: NonNullable<LanyardResponse["data"]>["discord_user"],
    ) {
      const avatar = this.querySelector<HTMLImageElement>(
        ".discord-avatar-image",
      )
      const decoration = this.querySelector<HTMLImageElement>(
        ".discord-avatar-decoration",
      )

      if (avatar && user.avatar) {
        const extension = user.avatar.startsWith("a_") ? "gif" : "webp"
        avatar.onload = () => avatar.setAttribute("data-loaded", "")
        avatar.src = `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.${extension}?size=160`
      }

      const decorationAsset = user.avatar_decoration_data?.asset
      if (decoration && decorationAsset) {
        decoration.src = `https://cdn.discordapp.com/avatar-decoration-presets/${decorationAsset}.png?size=160&passthrough=true`
      }
    }

    private renderActivity(activity: DiscordActivity) {
      const container = this.querySelector<HTMLElement>(".discord-activity")
      const isSpotify = activity.type === 2 && activity.name === "Spotify"
      container?.removeAttribute("data-empty")
      container?.toggleAttribute("data-spotify", isSpotify)

      const label = this.querySelector<HTMLElement>(
        ".discord-activity-copy > span",
      )
      const name = this.querySelector<HTMLElement>(".discord-activity strong")
      const detail = this.querySelector<HTMLElement>(".discord-activity-detail")
      const state = this.querySelector<HTMLElement>(".discord-activity-state")
      const art = this.querySelector<HTMLImageElement>(".discord-activity-art")

      if (label) {
        label.textContent = isSpotify ? "" : "PLAYING A GAME"
      }
      if (name) name.textContent = activity.name || "Discord activity"
      if (detail) detail.textContent = activity.details || ""
      if (state) state.textContent = activity.state || ""

      const artUrl = activityAssetUrl(activity)
      if (art && artUrl) {
        art.src = artUrl
        art.alt = `${activity.name || "Discord activity"} artwork`
        art.setAttribute("data-visible", "")
        art.onerror = () => art.removeAttribute("data-visible")
      } else if (art) {
        art.removeAttribute("data-visible")
        art.removeAttribute("src")
        art.alt = ""
      }

      this.activityStartedAt = activity.timestamps?.start || null
      this.activityEndsAt = isSpotify ? activity.timestamps?.end || null : null
      this.updateActivityTime()
    }

    private renderNoActivity() {
      const container = this.querySelector<HTMLElement>(".discord-activity")
      container?.setAttribute("data-empty", "")
      container?.removeAttribute("data-spotify")

      const label = this.querySelector<HTMLElement>(
        ".discord-activity-copy > span",
      )
      const name = this.querySelector<HTMLElement>(".discord-activity strong")
      const detail = this.querySelector<HTMLElement>(".discord-activity-detail")
      const state = this.querySelector<HTMLElement>(".discord-activity-state")
      const art = this.querySelector<HTMLImageElement>(".discord-activity-art")

      if (label) label.textContent = ""
      if (name) name.textContent = "No Status !"
      if (detail) detail.textContent = ""
      if (state) state.textContent = ""
      art?.removeAttribute("data-visible")
      this.activityStartedAt = null
      this.activityEndsAt = null
      this.updateActivityTime()
    }

    private renderUnavailable() {
      const indicator = this.querySelector<HTMLElement>(".discord-avatar i")
      const name = this.querySelector<HTMLElement>(".discord-activity strong")
      const detail = this.querySelector<HTMLElement>(".discord-activity-detail")

      this.removeAttribute("data-loading")
      this.setAttribute("aria-busy", "false")

      if (indicator)
        indicator.setAttribute("aria-label", "Discord status unavailable")
      if (name) name.textContent = "Presence unavailable"
      if (detail) detail.textContent = "Retrying automatically"
    }

    private updateActivityTime() {
      const time = this.querySelector<HTMLElement>(".discord-activity-time")
      const current = this.querySelector<HTMLElement>(
        ".discord-spotify-current",
      )
      const total = this.querySelector<HTMLElement>(".discord-spotify-total")
      const progress = this.querySelector<HTMLElement>(
        ".discord-spotify-progress b",
      )

      if (!this.activityStartedAt) {
        if (time) time.textContent = ""
        if (current) current.textContent = "0:00"
        if (total) total.textContent = "0:00"
        if (progress) progress.style.inlineSize = "0%"
        return
      }

      const elapsedMs = Math.max(0, Date.now() - this.activityStartedAt)
      if (this.activityEndsAt) {
        const durationMs = this.activityEndsAt - this.activityStartedAt
        const clampedElapsedMs = Math.min(elapsedMs, durationMs)
        const percentage = Math.max(
          0,
          Math.min(100, (clampedElapsedMs / durationMs) * 100),
        )

        if (time) time.textContent = ""
        if (current) current.textContent = this.formatDuration(clampedElapsedMs)
        if (total) total.textContent = this.formatDuration(durationMs)
        if (progress) progress.style.inlineSize = `${percentage}%`
        return
      }

      const totalSeconds = Math.floor(elapsedMs / 1_000)
      const hours = Math.floor(totalSeconds / 3_600)
      const minutes = Math.floor((totalSeconds % 3_600) / 60)
      const seconds = totalSeconds % 60
      if (time) {
        time.textContent = `${hours.toString().padStart(2, "0")}:${minutes
          .toString()
          .padStart(2, "0")}:${seconds.toString().padStart(2, "0")} elapsed`
      }
    }

    private formatDuration(milliseconds: number) {
      const totalSeconds = Math.max(0, Math.floor(milliseconds / 1_000))
      const minutes = Math.floor(totalSeconds / 60)
      const seconds = totalSeconds % 60
      return `${minutes}:${seconds.toString().padStart(2, "0")}`
    }
  }

  if (!customElements.get("discord-presence")) {
    customElements.define("discord-presence", DiscordPresenceElement)
  }
</script>
